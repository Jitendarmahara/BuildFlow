# Copy to deploy/config.env and fill in. deploy/config.env is gitignored (holds secrets).
# Everything in the deploy is driven from this one file.

# ---- GCP / Artifact Registry ----
PROJECT_ID=your-gcp-project-id       # from console.cloud.google.com
REGION=us-central1                   # region of your Artifact Registry + GKE cluster
AR_REPO=lovable                      # Artifact Registry repo name (you create it once)
IMAGE_TAG=v1                         # BUMP THIS on every rebuild (treat it as immutable)

# ---- your domain ----
DOMAIN=example.com                   # you must own it; you'll point DNS at the Caddy LB IP

# ---- in-cluster Postgres ----
DB_PASSWORD=change-me-to-something-strong

# ---- app secrets (same ones you use locally) ----
DEEPSEEK_API_KEY=sk-...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=...
AWS_BUCKET=...
JWT_SECRET=some-long-random-string
