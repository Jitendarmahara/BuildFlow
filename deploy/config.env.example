# Copy to deploy/config.env and fill in. deploy/config.env is gitignored (holds secrets).
# Everything in the deploy is driven from this one file.

# ---- GCP / Artifact Registry ----
PROJECT_ID=your-gcp-project-id       # from console.cloud.google.com
REGION=us-central1                   # region of your Artifact Registry + GKE cluster
AR_REPO=lovable                      # Artifact Registry repo name (you create it once)
IMAGE_TAG=v1                         # BUMP THIS on every rebuild (treat it as immutable)

# ---- public address ----
# Easiest ($0, no domain): reserve a static IP and use nip.io, which resolves
# <anything>.<ip>.nip.io -> <ip> with no DNS setup and real Let's Encrypt HTTPS.
#   gcloud compute addresses create lovable-ip --region <REGION>
#   gcloud compute addresses describe lovable-ip --region <REGION> --format='value(address)'
# Then set LB_IP to that address and DOMAIN to <ip>.nip.io.
# (If LE ever rate-limits nip.io, swap .nip.io -> .sslip.io and redeploy.)
# Own a domain instead? Set DOMAIN=example.com and point app/api/ws/*.preview A records at LB_IP.
LB_IP=34.0.0.0                       # reserved static IP the Caddy LoadBalancer pins to
DOMAIN=34.0.0.0.nip.io               # LB_IP + .nip.io  (or your own domain)

# ---- in-cluster Postgres ----
DB_PASSWORD=change-me-to-something-strong

# ---- app secrets (same ones you use locally) ----
DEEPSEEK_API_KEY=sk-...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=...
AWS_BUCKET=...
JWT_SECRET=some-long-random-string
